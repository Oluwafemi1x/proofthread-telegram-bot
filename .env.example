PROOFTHREAD_TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
PROOFTHREAD_DATABASE_URL=sqlite+aiosqlite:///./data/proofthread.db
PROOFTHREAD_AUTO_MIGRATE=true
PROOFTHREAD_MODE=polling
PROOFTHREAD_LOG_LEVEL=INFO
PROOFTHREAD_DEFAULT_TIMEZONE=UTC
PROOFTHREAD_REMINDER_INTERVAL_SECONDS=60
PROOFTHREAD_REMINDER_WINDOW_MINUTES=15

# Used by the local PostgreSQL service in compose.yaml; replace outside local development.
POSTGRES_PASSWORD=proofthread-local-only

# Required only in webhook mode
PROOFTHREAD_WEBHOOK_BASE_URL=https://bot.example.com
PROOFTHREAD_WEBHOOK_PATH=/telegram/webhook
PROOFTHREAD_WEBHOOK_SECRET=replace-with-a-long-random-value
PROOFTHREAD_WEB_HOST=0.0.0.0
PROOFTHREAD_WEB_PORT=8080
